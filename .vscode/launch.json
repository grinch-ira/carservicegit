{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run carservice-1",
      "type": "java",
      "request": "launch",
      "args": [
        "--spring.profiles.active=default"
      ],
      "mainClass": "customer.carservice.Application",
      "projectName": "carservice",
      "preLaunchTask": "PreLaunchTask for Run carservice-1",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/env/.env1",
      "env": {
        "run.config": "{\"handlerId\":\"cap_java_run_config_handler_id\",\"runnableId\":\"{\\\"projectPath\\\":\\\"/home/user/projects/carservice\\\",\\\"profileName\\\":\\\"default\\\"}\"}"
      }
    }
  ]
}